rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'defaultCurrency', 'localeCode', 'monthStartDay'])
          && data.uid == request.auth.uid
          && data.displayName is string
          && data.displayName.size() > 0
          && data.displayName.size() <= 120
          && data.email is string
          && data.defaultCurrency is string
          && data.defaultCurrency.size() == 3
          && data.localeCode is string
          && data.monthStartDay is int
          && data.monthStartDay >= 1
          && data.monthStartDay <= 28;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /profile/{profileId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidProfile(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /accounts/{accountId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
            && request.resource.data.initialBalanceCents is int
            && request.resource.data.currentBalanceCents is int;
      }

      match /categories/{categoryId} {
        allow read, write: if isOwner(userId);
      }

      match /credit_cards/{cardId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
            && request.resource.data.totalLimitCents is int
            && request.resource.data.totalLimitCents >= 0;
      }

      match /invoices/{invoiceId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
            && request.resource.data.totalAmountCents is int
            && request.resource.data.paidAmountCents is int;
      }

      match /transactions/{transactionId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
            && request.resource.data.amountCents is int
            && request.resource.data.amountCents > 0;
      }

      match /recurring/{recurringId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
            && request.resource.data.amountCents is int
            && request.resource.data.amountCents > 0;
      }

      match /installments/{installmentId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
            && request.resource.data.totalAmountCents is int
            && request.resource.data.totalAmountCents > 0;
      }

      match /budgets/{budgetId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
            && request.resource.data.limitCents is int
            && request.resource.data.limitCents > 0;
      }

      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId);
      }

      match /ai_interactions/{interactionId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
